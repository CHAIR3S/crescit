# Copia este archivo como .env.local (en local) o crea estas variables en Vercel.
# Todo es opcional: lo que no esté configurado simplemente no se muestra.

# URL pública del sitio (canonical, sitemap, Open Graph). En Vercel se toma sola del dominio de producción.
NEXT_PUBLIC_SITE_URL=https://www.tudominio.es

# Canales públicos. Si se dejan vacíos, la web no enseña correo ni botón de WhatsApp.
# NEXT_PUBLIC_CONTACT_EMAIL=hola@tudominio.es
# WhatsApp en formato internacional, solo cifras (34 + número).
# NEXT_PUBLIC_WHATSAPP_NUMBER=34XXXXXXXXX

# Envío del formulario de contacto con Resend (https://resend.com).
# Sin RESEND_API_KEY y CONTACT_TO_EMAIL el formulario avisa de que no está conectado y no simula el envío.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# CONTACT_TO_EMAIL=buzon@tudominio.es
# Remitente verificado en Resend. Si no se indica, se usa el remitente de pruebas de Resend.
# CONTACT_FROM_EMAIL=Crescit <web@tudominio.es>
